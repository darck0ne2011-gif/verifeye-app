# --- Server ------------------------------------------------------------------
PORT=3001
# development | production | test
NODE_ENV=development

# Required in production. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- Database ----------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Render Postgres, ...).
# Required in production. When empty in development, an embedded PGlite
# database is used and stored in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# Temporary storage for uploads while a scan runs (cleaned up automatically).
UPLOADS_DIR=./data/uploads
# How many scans run in parallel in this process.
SCAN_WORKER_CONCURRENCY=2

# --- URLs / CORS -------------------------------------------------------------
# Where the web app is served; used for OAuth redirects and CORS.
FRONTEND_URL=http://localhost:5173
# Public URL of this API; used for OAuth callback URLs.
API_BASE=http://localhost:3001
# Extra allowed browser origins, comma-separated (optional).
CORS_ORIGINS=

# --- Accounts ----------------------------------------------------------------
# Comma-separated emails that get the admin role (unlimited scans, admin API).
ADMIN_EMAILS=darck0ne2011@gmail.com

# --- Detection providers -----------------------------------------------------
# Sightengine (required for scans) - https://dashboard.sightengine.com
# Images and video frames use the genai/deepfake models. Audio uses `ai_speech`,
# which is in beta: ask Sightengine to enable it on the account, otherwise audio
# scans fail with MODEL_NOT_ENABLED and the credit is refunded.
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# DeepSeek (optional) - short written interpretation of each scan.
DEEPSEEK_API_KEY=

# Fact-checking of social posts (optional; DEEPSEEK_API_KEY is required for it).
# Google Fact Check Tools API key (free): https://developers.google.com/fact-check/tools/api
GOOGLE_FACTCHECK_API_KEY=
# One web search provider for evidence: Tavily (https://tavily.com) or Brave (https://brave.com/search/api/)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- OAuth (optional) --------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Sign In: requires an Apple Developer account
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
