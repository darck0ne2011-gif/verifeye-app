# --- Server ------------------------------------------------------------------
PORT=3001
# development | production | test
NODE_ENV=development

# Required in production. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# --- Database ----------------------------------------------------------------
# Postgres connection string (Neon, Supabase, Render Postgres, ...).
# Required in production. When empty in development, an embedded PGlite
# database is used and stored in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=./data/pglite

# --- URLs / CORS -------------------------------------------------------------
# Where the web app is served; used for OAuth redirects and CORS.
FRONTEND_URL=http://localhost:5173
# Public URL of this API; used for OAuth callback URLs.
API_BASE=http://localhost:3001
# Extra allowed browser origins, comma-separated (optional).
CORS_ORIGINS=

# --- Accounts ----------------------------------------------------------------
# Comma-separated emails that get the admin role (unlimited scans, admin API).
ADMIN_EMAILS=andrei@test.test,inta@test.test

# --- Detection providers -----------------------------------------------------
# Sightengine (required for scans) - https://dashboard.sightengine.com
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# DeepSeek (optional) - short written interpretation of each scan.
DEEPSEEK_API_KEY=

# --- OAuth (optional) --------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Sign In: requires an Apple Developer account
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
